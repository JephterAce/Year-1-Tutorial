# Copy to your host's secret manager or local untracked .env file.
# Never commit real credentials. Use separate development, staging and production values.

APP_ENV=development
DATABASE_URL=postgresql://learnwise:CHANGE_ME@localhost:5432/learnwise
PUBLIC_APP_URL=https://your-approved-domain.example

# Generate independent random values of at least 32 characters.
AUTH_RATE_LIMIT_PEPPER=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
AUDIO_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
AUDIO_STORAGE_ROOT=/var/lib/learnwise/private-audio

PRIVACY_NOTICE_VERSION=draft-1
TERMS_VERSION=draft-1

# Student verification/reset email and payment alert worker.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PAYMENT_ALERT_RECIPIENT=

# Keep real payments disabled until staging sandbox E2E and finance approval pass.
PAYSTACK_SECRET_KEY=

# Private object storage (staging only; inject branch-scoped AWS_* values in host secrets)
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_BUCKET=learnwise-private-audio
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Private administrator export storage: use a separate private bucket and bucket-scoped credentials.
# Do not point this at the audio bucket. Worker stays disabled until storage/retention are approved.
DATA_EXPORT_STORAGE_BUCKET=
DATA_EXPORT_AWS_ENDPOINT_URL_S3=
DATA_EXPORT_AWS_REGION=eu-central-1
DATA_EXPORT_AWS_ACCESS_KEY_ID=
DATA_EXPORT_AWS_SECRET_ACCESS_KEY=
DATA_EXPORT_WORKER_ENABLED=false
DATA_EXPORT_TTL_HOURS=24
