# Copy to your host's secret manager or local untracked .env file.
# Never commit real credentials. Use separate development, staging and production values.

APP_ENV=development
DATABASE_URL=postgresql://learnwise:CHANGE_ME@localhost:5432/learnwise
PUBLIC_APP_URL=https://your-approved-domain.example

# Generate independent random values of at least 32 characters.
AUTH_RATE_LIMIT_PEPPER=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
AUDIO_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
AUDIO_STORAGE_ROOT=/var/lib/learnwise/private-audio

PRIVACY_NOTICE_VERSION=draft-1
TERMS_VERSION=draft-1

# Student verification/reset email and payment alert worker.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PAYMENT_ALERT_RECIPIENT=

# Keep real payments disabled until staging sandbox E2E and finance approval pass.
PAYSTACK_SECRET_KEY=
