# Copy to .env locally; never commit the real .env file.
# Use a dedicated database for this platform, never the legacy Year 1 bot database.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
APP_ENV=development
# Explicit opt-in for the owner-only staging transactional-email diagnostic; leave disabled elsewhere.
ADMIN_SMTP_DIAGNOSTIC_ENABLED=false
# Future integrations (add only when their modules are implemented):
PAYSTACK_SECRET_KEY=
TELEGRAM_BOT_TOKEN=

# Owner notifications for verified Learnwise payments.
# Brevo transactional email API credentials are supplied privately by the owner.
# Sender email must be verified/approved in the Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Think Tank
PAYMENT_ALERT_RECIPIENT=emmanuelbjephter@gmail.com

# Student identity security. Generate a unique random value of at least 32 characters.
AUTH_RATE_LIMIT_PEPPER=
# Public HTTPS origin used to construct email verification and password-reset links.
PUBLIC_APP_URL=https://learnwise.example
PRIVACY_NOTICE_VERSION=draft-1
TERMS_VERSION=draft-1

# AI tutor provider (OpenAI-compatible Chat Completions API).
# Keep disabled until durable per-student usage quotas, budget alerts and privacy review are complete.
AI_TUTOR_ENABLED=false
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_ALLOWED_HOSTS=api.openai.com
AI_API_KEY=
AI_MODEL=

# Database-backed AI tutor quotas and conservative cost reservations.
# Price values must match the selected provider/model tariff; leave blank to fail closed.
AI_TUTOR_DAILY_REQUEST_LIMIT=20
AI_TUTOR_MONTHLY_REQUEST_LIMIT=300
AI_TUTOR_DAILY_BUDGET_MICROUSD=1000000
AI_TUTOR_MONTHLY_BUDGET_MICROUSD=10000000
AI_INPUT_COST_MICROUSD_PER_1M_TOKENS=
AI_OUTPUT_COST_MICROUSD_PER_1M_TOKENS=

AI_TUTOR_PLATFORM_DAILY_BUDGET_MICROUSD=10000000
AI_TUTOR_PLATFORM_MONTHLY_BUDGET_MICROUSD=100000000

# Private audio objects in the private Neon S3-compatible bucket.
# AUDIO_STORAGE_* takes precedence; AWS_* remains supported for existing deployments.
AUDIO_STORAGE_ACCESS_KEY_ID=
AUDIO_STORAGE_SECRET_ACCESS_KEY=
AUDIO_STORAGE_ENDPOINT_URL_S3=
AUDIO_STORAGE_REGION=
AUDIO_STORAGE_BUCKET=

# Private admin data exports. Configure a dedicated private R2 bucket and a separate bucket-scoped Object Read & Write token.
# Cloudflare R2 S3 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_* aliases are accepted by the staging acceptance probe when DATA_EXPORT_* is not set.
# Keep the worker disabled until a second administrator, retention policy and storage controls are verified.
DATA_EXPORT_STORAGE_BUCKET=
DATA_EXPORT_AWS_ENDPOINT_URL_S3=
DATA_EXPORT_AWS_REGION=auto
DATA_EXPORT_AWS_ACCESS_KEY_ID=
DATA_EXPORT_AWS_SECRET_ACCESS_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_REGION=auto
R2_BUCKET_NAME=
DATA_EXPORT_WORKER_ENABLED=false
DATA_EXPORT_TTL_HOURS=24

# Staging-only synthetic browser QA identity. Configure only on the staging service.
# Keep disabled by default; use a dedicated QA mailbox, never a learner's address.
STAGING_QA_IDENTITY_ENABLED=false
STAGING_QA_EMAIL=

# Owner-triggered, staging-only synthetic private-storage acceptance probe.
STAGING_STORAGE_DIAGNOSTICS_ENABLED=false
